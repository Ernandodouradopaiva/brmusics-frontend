# brmusics-frontend — produção (Docker / runtime).

# --- Runtime ---
# Ambiente Node (development|production).
NODE_ENV=production
# Host de bind do servidor Next.
HOSTNAME=0.0.0.0
# Porta HTTP do frontend.
PORT=3002

# --- Aplicação ---
# URL interna da brmusics-api (proxy BFF).
BRMUSICS_API_INTERNAL_URL=http://brmusics-api:8081
# URL pública do frontend (links, SSR).
APP_URL=http://localhost:3002
NEXT_PUBLIC_APP_URL=http://localhost:3002
